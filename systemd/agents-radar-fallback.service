[Unit]
Description=Generate and deliver the daily Agents Radar digest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/agents-radar/env
WorkingDirectory=%h/.local/share/agents-radar
ExecStart=%h/.local/share/agents-radar/scripts/daily-fallback.sh
TimeoutStartSec=45min

[Install]
WantedBy=default.target
